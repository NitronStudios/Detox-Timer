{
  "appId": "com.nitronstudios.detoxtimer",
  "appName": "Detox Timer",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "StatusBar": {
      "backgroundColor": "#000000",
      "style": "DARK"
    },
    "NavigationBar": {
      "backgroundColor": "#000000",
      "style": "DARK"
    }
  }
}
